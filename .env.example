# Leave empty so the build validates config; set to 1 only to boot with gaps.
SKIP_ENV_VALIDATION=

# Database - Prisma Postgres (no card required)
DATABASE_URL=

APP_URL=http://localhost:3000

# Auth - Clerk (no card required). Organizations must be ENABLED in the dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Storage - Supabase Storage over its S3-compatible API (no card required).
# Endpoint looks like https://<project-ref>.storage.supabase.co/storage/v1/s3
# Keys come from Project Settings -> Storage -> S3 Access Keys. Keep the bucket PRIVATE.
STORAGE_BUCKET=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# TTS - a Hugging Face Space running Chatterbox on ZeroGPU (no card required).
# Duplicate https://huggingface.co/spaces/ResembleAI/Chatterbox and pick ZeroGPU hardware.
HF_SPACE_ID=your-username/Chatterbox
HF_TOKEN=

# Billing - optional. Leave false to run with no payment provider at all.
BILLING_ENABLED=false
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_SERVER=sandbox
POLAR_METER_VOICE_CREATION=voice_creation
POLAR_METER_TTS_GENERATION=tts_generation
POLAR_METER_TTS_PROPERTY=characters

# Error monitoring - optional. Nothing is sent unless a DSN is set.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
